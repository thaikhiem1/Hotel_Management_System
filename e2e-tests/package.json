{
  "name": "hotel-e2e-tests",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:ui-mode": "playwright test --ui",
    "test:headed": "playwright test --headed --project=chromium",
    "test:slow": "cross-env SLOWMO=700 playwright test --headed --project=chromium --workers=1",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test tests/e2e",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:5173"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "cross-env": "^7.0.3"
  }
}
