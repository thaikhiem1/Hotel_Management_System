# ============================================================
# Mẫu cấu hình môi trường cho Backend (Spring Boot) và Docker Compose.
# Cách dùng: sao chép thành backend/.env rồi sửa giá trị cho máy của bạn
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Git Bash / Linux / macOS:  cp .env.example .env
# Tệp .env được cả Spring Boot (spring.config.import) và docker-compose.yaml đọc.
# Biến nào bỏ trống hoặc xóa thì Spring Boot dùng giá trị mặc định ghi trong application.properties.
# KHÔNG đưa mật khẩu và JWT_SECRET thật vào tệp .env.example.
# ============================================================

# ---------- ỨNG DỤNG ----------
APP_Name=QLKS
SERVER_PORT=8080

# ---------- POSTGRESQL ----------
# Cổng PostgreSQL trên máy (đổi cả DB_URL nếu đổi POSTGRES_HOST_PORT)
POSTGRES_HOST_PORT=5434
DB_URL=jdbc:postgresql://localhost:5434/QLKS_database
DB_USERNAME=QLKS_user
DB_PASSWORD=QLKS_password
DB_DRIVER=org.postgresql.Driver

# ---------- REDIS ----------
REDIS_HOST=localhost
REDIS_HOST_PORT=6379

# ---------- FLYWAY (migration cơ sở dữ liệu) ----------
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_LOCATIONS=classpath:db/migration
FLYWAY_VALIDATE_ON_MIGRATE=true

# ---------- JPA / HIBERNATE ----------
JPA_DDL_AUTO=none
JPA_DEFER_DATASOURCE_INITIALIZATION=false
JPA_OPEN_IN_VIEW=false

# ---------- JWT ----------
# Khóa ký token, tối thiểu 32 ký tự. BẮT BUỘC đặt giá trị riêng khi triển khai thật.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Thời gian sống của token (mili giây), mặc định 8 giờ
JWT_EXPIRATION_MS=28800000

# ---------- TÀI KHOẢN ADMIN KHỞI TẠO ----------
# Chỉ được tạo khi hệ thống chưa có tài khoản ADMIN nào (migration seed đã tạo sẵn admin/123456 nên thường không dùng đến)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# ---------- ẢNH ĐẠI DIỆN NGƯỜI DÙNG TẢI LÊN ----------
# Thư mục lưu ảnh (tính theo thư mục chạy backend, tức backend/hotel). Thư mục này đã được .gitignore.
AVATAR_UPLOAD_DIR=uploads/avatars
